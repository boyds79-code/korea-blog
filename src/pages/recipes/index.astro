---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const allPosts = await getCollection('recipes', ({ data }) => data.draft !== true);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base
  title="Korean Recipes, Explained — Easy Korean Home Cooking"
  description="Approachable Korean recipes for English-speaking home cooks: stews, stir-fries, rice bowls, street food snacks, ramen upgrades, and quick banchan."
>
  <h1>Korean Recipes, Explained</h1>
  <p>Approachable Korean recipes for home cooks outside Korea — from classic favorites to quick weeknight dishes.</p>

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        {post.data.heroImage && (
          <a href={`/recipes/${post.slug}/`} class="thumb">
            <img src={post.data.heroImage} alt={post.data.heroImageAlt || post.data.title} loading="lazy" />
          </a>
        )}
        <div>
          <a href={`/recipes/${post.slug}/`}>{post.data.title}</a>
          <p class="excerpt">{post.data.description}</p>
          <p class="date">
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            {post.data.difficulty && <span> · {post.data.difficulty}</span>}
            {post.data.cookTime && <span> · {post.data.cookTime}</span>}
          </p>
        </div>
      </li>
    ))}
  </ul>
</Base>

<style>
  .post-list { list-style: none; padding: 0; }
  .post-list li { margin-bottom: 2rem; border-bottom: 1px solid #eee; padding-bottom: 1.5rem; display: flex; gap: 1rem; align-items: flex-start; }
  .post-list .thumb { flex-shrink: 0; width: 140px; }
  .post-list .thumb img { width: 140px; height: 100px; object-fit: cover; border-radius: 6px; display: block; }
  .post-list a { font-size: 1.2rem; font-weight: 600; text-decoration: none; }
  .excerpt { color: #444; margin: 0.4rem 0; }
  .date { color: #999; font-size: 0.8rem; margin: 0; }
</style>
