---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  prepTime?: string;
  cookTime?: string;
  servings?: string;
  difficulty?: string;
  ingredients: string[];
  heroImage?: string;
  heroImageAlt?: string;
  heroImageCredit?: string;
  heroImageCreditUrl?: string;
}
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  prepTime,
  cookTime,
  servings,
  difficulty,
  ingredients,
  heroImage,
  heroImageAlt,
  heroImageCredit,
  heroImageCreditUrl,
} = Astro.props;

// "15 minutes" / "1 hour 20 minutes" 같은 사람이 읽는 표기를 구글 Recipe 구조화 데이터가
// 요구하는 ISO 8601 duration("PT15M", "PT1H20M")으로 최대한 변환. 실패하면 그냥 생략.
function toISODuration(text?: string): string | undefined {
  if (!text) return undefined;
  const h = text.match(/(\d+)\s*h/i);
  const m = text.match(/(\d+)\s*m/i);
  if (!h && !m) return undefined;
  let out = 'PT';
  if (h) out += `${h[1]}H`;
  if (m) out += `${m[1]}M`;
  return out;
}

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  ...(heroImage ? { image: heroImage } : {}),
  ...(ingredients.length > 0 ? { recipeIngredient: ingredients } : {}),
  ...(servings ? { recipeYield: servings } : {}),
};
const prepISO = toISODuration(prepTime);
const cookISO = toISODuration(cookTime);
if (prepISO) jsonLd.prepTime = prepISO;
if (cookISO) jsonLd.cookTime = cookISO;
---
<Base title={`${title} | Korean Recipes, Explained`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="meta">
        {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {tags.length > 0 && <span class="tags"> · {tags.join(', ')}</span>}
      </p>
    </header>

    {heroImage && (
      <figure class="hero">
        <img src={heroImage} alt={heroImageAlt || title} loading="eager" />
        {heroImageCredit && (
          <figcaption>
            {heroImageCreditUrl ? (
              <a href={heroImageCreditUrl} target="_blank" rel="noopener nofollow">{heroImageCredit}</a>
            ) : (
              heroImageCredit
            )}
          </figcaption>
        )}
      </figure>
    )}

    {(prepTime || cookTime || servings || difficulty) && (
      <ul class="recipe-stats">
        {prepTime && <li><strong>Prep</strong><br />{prepTime}</li>}
        {cookTime && <li><strong>Cook</strong><br />{cookTime}</li>}
        {servings && <li><strong>Serves</strong><br />{servings}</li>}
        {difficulty && <li><strong>Difficulty</strong><br />{difficulty}</li>}
      </ul>
    )}

    <AdSlot position="top" />

    {ingredients.length > 0 && (
      <section class="ingredients">
        <h2>Ingredients</h2>
        <ul>
          {ingredients.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <div class="prose">
      <slot />
    </div>

    <AdSlot position="bottom" />
  </article>
</Base>

<style>
  .post-header { margin-bottom: 1rem; }
  .meta { color: #666; font-size: 0.85rem; }
  .hero { margin: 0 0 1.5rem; }
  .hero img { width: 100%; height: auto; border-radius: 8px; display: block; }
  .hero figcaption { font-size: 0.75rem; color: #999; margin-top: 0.4rem; text-align: right; }
  .hero figcaption a { color: #999; }
  .recipe-stats {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 1rem 1.25rem;
    margin: 0 0 1.5rem;
    background: #fdf6f2;
    border-radius: 8px;
    font-size: 0.85rem;
  }
  .recipe-stats strong { font-size: 0.75rem; color: #999; text-transform: uppercase; }
  .ingredients {
    background: #fafafa;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .ingredients h2 { margin-top: 0; }
  .ingredients ul { padding-left: 1.2rem; }
  .ingredients li { margin: 0.3rem 0; }
  .prose { font-size: 1.0625rem; }
  .prose :global(h2) { margin-top: 2.5rem; padding-bottom: 0.4rem; border-bottom: 1px solid #eee; }
  .prose :global(h3) { margin-top: 1.75rem; }
  .prose :global(p) { margin: 1.1rem 0; }
  .prose :global(p:first-of-type) { font-size: 1.15rem; }
  .prose :global(strong) { color: #1a1a1a; }
  .prose :global(ul), .prose :global(ol) { margin: 1rem 0; padding-left: 1.4rem; }
  .prose :global(li) { margin: 0.4rem 0; }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.9rem 1.25rem;
    background: #fdf6f2;
    border-left: 4px solid #b0243d;
    border-radius: 6px;
  }
  .prose :global(blockquote p) { margin: 0.3rem 0; }
  .prose :global(img) { width: 100%; height: auto; border-radius: 8px; margin: 1.5rem 0; display: block; }
</style>
